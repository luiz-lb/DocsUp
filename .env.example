# =============================================================================
# DocsUp: variáveis do docker-compose. Copie para .env (nesta pasta) e preencha.
# O .env é ignorado pelo git. Nunca versione valores reais.
# Se um valor tiver $, # ou espaço, coloque entre aspas simples: SENHA='a$b#c'
# =============================================================================

# ── Banco (SQL Server 2022) ──────────────────────────────────────────────────
# Senha do sa (administrador). Só o serviço db-init usa; o backend NUNCA usa o sa.
# Regra do SQL Server: mínimo de 8 caracteres e 3 destes 4 grupos:
# maiúsculas, minúsculas, números e símbolos.
# ATENÇÃO: só vale na 1ª subida (volume do banco vazio). Depois disso, mudar aqui NÃO troca a
# senha no servidor, e o stack para de subir. Para trocar: database/README.md, "Trocar a senha do sa".
MSSQL_SA_PASSWORD=
# Developer: gratuita, só para desenvolvimento/teste.
# Produção: Express (gratuita, com limites) ou uma edição licenciada.
MSSQL_PID=Developer
# Porta do SQL Server na máquina (só 127.0.0.1), para SSMS / Azure Data Studio.
# No SSMS use "127.0.0.1,14330": vírgula (não dois-pontos) e 127.0.0.1 (não "localhost",
# que no Windows tenta IPv6 primeiro e não conecta). Marque "Certificado do Servidor de Confiança".
DB_HOST_PORT=14330

# Database e usuário da APLICAÇÃO (leitura, escrita e EXECUTE; sem DDL, sem db_owner).
# Mesmos nomes usados em backend/src/config/dbConfig.js. Nomes: só letras, números e _.
# DB_PASSWORD segue a mesma regra de complexidade da senha do sa.
DB_DATABASE=SupplierManagementPreview
DB_USERENV=docsup_app
DB_PASSWORD=
# Criptografa a conexão backend -> banco (o container usa certificado autoassinado)
DB_ENCRYPT=true
DB_TRUST_CERT=true

# ── Backend ──────────────────────────────────────────────────────────────────
# production: cookies de login (JWT) com Secure e OTP do fornecedor só por e-mail. Exige
# HTTPS na frente (proxy reverso): por HTTP fora de localhost o navegador descarta o cookie
# e o login parece funcionar, mas a chamada seguinte dá 401. Front e back precisam estar no
# mesmo domínio (ex.: app.empresa.com.br e api.empresa.com.br), porque o cookie é SameSite=Lax.
# Para testar localmente em http://localhost sem SMTP, use dev (o OTP volta na resposta;
# NUNCA use dev em produção).
NODE_ENV=production
BACKEND_PORT=3003
# Precisa ser o mesmo fuso do SQL Server: o backend lê e grava datas no horário local
TZ=America/Sao_Paulo
# Gere cada um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET (colaboradores) e SUPPLIER_JWT_SECRET (fornecedores) devem ser diferentes.
SESSION_SECRET=
JWT_SECRET=
SUPPLIER_JWT_SECRET=
WEBHOOK_SECRET=
# Endereço exato do frontend como o navegador acessa (CORS). Tem que bater com FRONTEND_PORT.
FRONTEND_URL=http://localhost:8080
# Quantos proxies reversos (nginx, IIS...) ficam na frente do backend. Em produção com HTTPS
# num proxy, use 1: o IP da auditoria passa a ser o do usuário e o cookie da sessão ganha
# Secure. Vazio = sem proxy (local): não confia nos cabeçalhos X-Forwarded-*.
TRUST_PROXY=

# Admin inicial do sistema: criado pelo backend na 1ª subida, se o e-mail ainda não existir.
# SENHA_ADMIN aceita a senha em texto (mín. 8 caracteres e 3 de 4 grupos: maiúsculas,
# minúsculas, números e símbolos) ou, melhor, um hash bcrypt, para não deixar a senha
# em texto aqui. Hash SEMPRE entre aspas simples, senão o $ vira variável:
#   SENHA_ADMIN='$2b$10$...'
# Para gerar o hash, na pasta backend (com npm install feito), rode o comando abaixo: ele
# PERGUNTA a senha. Não escreva a senha dentro do comando: no PowerShell e no bash o $ dentro
# de "..." é trocado sem aviso (o hash sai de outra senha) e a linha fica no histórico.
# O hash não passa pela regra de senha: escolha uma senha que a atenda.
#   node -e "const rl=require('readline').createInterface({input:process.stdin,output:process.stdout});rl.question('Senha: ',(s)=>{console.log(require('bcrypt').hashSync(s.replace(/^﻿|\r$/g,''),10));rl.close()})"
# Depois de criado, mudar SENHA_ADMIN aqui NÃO altera a senha, e a variável pode ser apagada.
USER_ADMIN=
SENHA_ADMIN=

# E-mail (SMTP). Hoje o envio está desligado no código; ficam aqui para quando for religado.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SUPRIMENTOS_EMAIL=

# Token da API Hub do Desenvolvedor (validação de FGTS)
HUBDEV_TOKEN=

# ── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_PORT=8080
# URL do backend como o NAVEGADOR acessa. Vai embutida no build:
# mudou aqui, rode `docker compose build frontend`.
VITE_URL_BACKEND=http://localhost:3003
